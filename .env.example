# ─────────────────────────────────────────────────────────────
# OXYGEN EDU-HUB — environment variables (copy to .env)
# All VITE_* values are PUBLIC: they are embedded in the website.
# Never put private secrets here.
# ─────────────────────────────────────────────────────────────

# Production URL, no trailing slash. Used for canonical URLs, sitemap.xml, OG tags.
VITE_SITE_URL=https://www.your-domain.in

# Forms — choose a provider: web3forms | formspree | mailto
# web3forms: set VITE_FORM_ACCESS_KEY (endpoint optional, defaults to https://api.web3forms.com/submit)
# formspree: set VITE_FORM_ENDPOINT to your form URL, e.g. https://formspree.io/f/xxxxxx
# Leave both empty to use the built-in email/WhatsApp fallback.
VITE_FORM_PROVIDER=
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Optional Cloudflare Turnstile (spam protection) — public site key
VITE_TURNSTILE_SITE_KEY=

# Optional analytics — loaded ONLY after the visitor accepts cookies
VITE_GA4_ID=
VITE_PLAUSIBLE_DOMAIN=
